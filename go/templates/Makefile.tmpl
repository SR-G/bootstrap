BUILD_VERSION ?= 0.0.1
BUILD_VERSION_LABEL ?= DEV
BUILD_COMMIT := $(shell git rev-parse --short HEAD 2>/dev/null)
BUILD_COMPILATION_TIMESTAMP := $(shell date -u +%Y-%m-%dT%H:%M:%SZ)

LDFLAGS := -X 'main.BuildVersion=$(BUILD_VERSION)' \
	-X 'main.BuildVersionLabel=$(BUILD_VERSION_LABEL)' \
	-X 'main.BuildCommit=$(BUILD_COMMIT)' \
	-X 'main.BuildCompilationTimestamp=$(BUILD_COMPILATION_TIMESTAMP)'

.PHONY: build run test envdoc

build:
	go build -ldflags "$(LDFLAGS)" -o {{ .ProjectName }} .

run:
	go run .

test:
	go test ./...

envdoc:
	go get -tool github.com/g4s8/envdoc@latest
	go generate ./...
